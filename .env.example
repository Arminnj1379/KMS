# Copy to .env for local dev (never commit .env)
NODE_ENV=development

# Postgres (compose service `db`)
DATABASE_URL=postgresql://kms:kms_secret@localhost:5432/kms?schema=public
POSTGRES_USER=kms
POSTGRES_PASSWORD=kms_secret
POSTGRES_DB=kms

# Backend
API_PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173
JWT_ACCESS_SECRET=change-me-access-min-32-chars-long-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL_DAYS=7

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin-secret-change-me
S3_BUCKET=kms-docs
S3_FORCE_PATH_STYLE=true

# Frontend (Vite; prefixed VITE_)
VITE_API_URL=http://localhost:3000/api
VITE_APP_NAME=سامانه مدیریت دانش
VITE_DEFAULT_LOCALE=fa
