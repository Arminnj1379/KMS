{
  "name": "kms",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise Knowledge Management System — modular monolith (NestJS + React)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=backend",
    "dev:web": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "build:api": "npm run build --workspace=backend",
    "build:web": "npm run build --workspace=frontend",
    "typecheck": "tsc --noEmit -p backend && tsc --noEmit -p frontend",
    "test": "npm test --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend"
  },
  "engines": {
    "node": ">=20"
  }
}
